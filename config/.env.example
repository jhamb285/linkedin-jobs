# Apify — LinkedIn post search
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=harvestapi/linkedin-post-search

# Google Gemini — AI scoring + comment/DM generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# Google Sheets — OPTIONAL. Only needed for legacy export flow. Leave unset to skip.
# GOOGLE_CREDENTIALS_PATH=
# GOOGLE_TOKEN_PATH=
# SPREADSHEET_ID=

# Database
DB_PATH=./data/leads.db

# Scoring
SCORING_THRESHOLD=25

# Rate Limits (match your PhantomBuster settings)
MAX_COMMENTS_PER_DAY=25
MAX_CONNECTIONS_PER_DAY=15
MAX_DMS_PER_DAY=50

# Apify cost controls
DAILY_SCRAPE_CAP=250
APIFY_COST_PER_LEAD=0.005
