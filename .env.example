# LinkedIn-Jobs CLI environment.
#
# DATABASE_URL must point at the SAME Postgres that platform/web reads from
# — the CLI populates posts/scores/engagement_drafts that the platform UI
# then renders.
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform

# Apify (https://apify.com)
APIFY_TOKEN=
APIFY_ACTOR_ID=harvestapi/linkedin-post-search
# harvestapi/linkedin-post-search bills at $1.50 / 1000 posts
APIFY_COST_PER_LEAD=0.0015
# Item-count cap = per-run volume lever. 650 posts × $0.0015 ≈ $0.975/day,
# just under the $1.00 cap. Backstopped by the rolling-24h $ guard below.
DAILY_SCRAPE_CAP=650

# Rolling-24h hard $ cap on LinkedIn Apify spend (src/lib/budget-guard.ts).
# Falls back to APIFY_DAILY_CAP_USD, then 1.00.
APIFY_LINKEDIN_DAILY_CAP=1.00

# Unified Apify daily $ cap — shared default across all inbound pipelines.
# Per-pipeline vars above (APIFY_LINKEDIN_DAILY_CAP) override this.
APIFY_DAILY_CAP_USD=1.00

# Gemini / Vertex AI — VERTEX_API_KEY is the canonical key (Vertex AI
# endpoint); GEMINI_API_KEY is the legacy fallback. Set VERTEX_API_KEY.
VERTEX_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# Expertise / RAG endpoints — used by the commenter to ground content
# generation in each persona's actual past projects. Each RAG has its
# own X-API-Key (the two APIs were forked but keys rotated separately).
# Set both per-persona keys in production. EXPERTISE_API_KEY is an
# optional shared fallback for back-compat.
EXPERTISE_API_PK_KEY=
EXPERTISE_API_AJ_KEY=
EXPERTISE_API_KEY=
EXPERTISE_API_PK_URL=https://par1kahl.kronus.tech/rag
EXPERTISE_API_AJ_URL=https://arpit.kronus.tech/rag

# Scoring + per-day caps
SCORING_THRESHOLD=20
MAX_COMMENTS_PER_DAY=25
MAX_CONNECTIONS_PER_DAY=15
MAX_DMS_PER_DAY=50

# Google Sheets export (optional — leave empty to skip)
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=

# Optional override for which query bundle to run
# QUERY_FILE=search-queries.json

# DB_PATH is no longer used (Phase 6 cut over from SQLite to Postgres),
# kept here for reference only — config.ts still reads it for back-compat
# with old loadConfig() signatures.
DB_PATH=./data/leads.db

# Platform internal API — used to call POST /api/internal/tag-contact
# after upserting a new contact so the lead gets Gemini-classified
# role tags at ingest time. Both must be set or the call is a no-op.
PLATFORM_API_URL=https://pipelines.kronus.tech
INTERNAL_API_KEY=
